# --- Dockerfile (React build + serve) ---

# 1️⃣ Giai đoạn build React app
FROM node:20 AS build

WORKDIR /app
COPY package*.json ./
RUN npm install
COPY . .
RUN npm run build

# 2️⃣ Giai đoạn chạy (dùng nginx)
FROM nginx:alpine
COPY --from=build /app/build /usr/share/nginx/html

# Expose port 80
EXPOSE 80

# Nginx tự động chạy
